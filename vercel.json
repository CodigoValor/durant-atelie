{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(index.html|config.js|adapter.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "painel.henriquedurant.com"
        }
      ],
      "destination": "/painel.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "painel-homolog.henriquedurant.com"
        }
      ],
      "destination": "/painel.html"
    }
  ]
}